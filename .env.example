APP_NAME=Mindful Moments Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

AUTH_REQUIRED=true
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_BUCKET=journal-audio
SUPABASE_JOURNALS_TABLE=journals
SUPABASE_PROFILES_TABLE=user_profiles
SIGNED_URL_EXPIRY_SECONDS=3600

GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

MAX_UPLOAD_MB=12
REQUEST_TIMEOUT_SECONDS=30
ANALYSIS_PROMPT_VERSION=v1

# Per-user rate limiting on the audio ingest endpoints. Counts are per
# authenticated user_id, enforced via Redis INCR + EXPIRE per fixed window.
# If Redis is unreachable the limiter fails open (logs a warning, allows
# the request) so a broker outage doesn't take down the API.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_INGEST_PER_MINUTE=5
RATE_LIMIT_INGEST_PER_HOUR=30
REDIS_URL=redis://localhost:6379/0
# Async ingest pipeline. When true, POST /v1/journals/ingest and POST /v1/recordings
# upload audio to storage synchronously and enqueue a Celery task for transcription
# and analysis, returning HTTP 202 immediately. Requires a reachable Redis broker
# and a running Celery worker. Set to false for local dev (single-process behavior).
INGEST_ASYNC=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Firebase Cloud Messaging (event-driven push notifications).
# Disabled by default: with FIREBASE_ENABLED=false every push is a no-op, so
# the API, the worker, and the test suite all run without a service account.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# Supply the service account EITHER as a path to the JSON file
# (FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json)
# OR as the raw JSON inline, which is usually easier on Render:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# If neither is set, the Admin SDK falls back to Application Default
# Credentials, which is the right choice when the runtime has the service
# account attached (e.g. GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
# Validate and log messages without delivering them. Keep this true in staging
# so production devices are not disturbed while you are testing.
FIREBASE_DRY_RUN=false
FIREBASE_DEVICES_TABLE=device_tokens
FIREBASE_NOTIFICATION_LOG_TABLE=notification_log
# FCM rejects a multicast with more than 500 tokens.
FCM_BATCH_SIZE=500

